{
  "schemaVersion": 1,
  "kind": "scenario",
  "name": "YouTube_31_Shorts_네트워크복구_DRAM",
  "description": " 반복 블록 1회. Shorts 10초 관측 · 광고 제외 → 네트워크 10초 차단·원복 → 5초 대기 → 재생 확인 → Shorts 30초 관측 · 광고 제외 FSIO UFS+DRAM 수집. 재생 시간은 광고·미확인을 제외한 표본 간 관측 시간이며 마지막 조회 간격만큼 늘어날 수 있습니다. 광고 조회가 측정 부하를 추가합니다. 잠금 해제·YouTube 초기 안내 완료가 필요합니다. 반복 중 같은 영상이 다시 나올 수 있습니다. 전체 반복·장시간 실행 검증 전이며 개별 공통 동작의 검증과 구분합니다.",
  "repeatCount": 1,
  "steps": [
    {
      "params": {
        "include_dram": "true",
        "include_vfs": "false",
        "label": "FSIO UFS + DRAM 수집 시작",
        "trace_type": "fsio_ufs",
        "window_seconds": "1"
      },
      "type": "trace_start"
    },
    {
      "type": "launch_app",
      "params": {
        "label": "앱 실행",
        "package_name": "com.google.android.youtube",
        "clear_mode": "force_stop",
        "wait_seconds": "3"
      }
    },
    {
      "type": "tap_element",
      "params": {
        "label": "Shorts 탭",
        "element_content_desc": "^(Shorts|쇼츠)(,.*)?$",
        "element_match_mode": "regex"
      }
    },
    {
      "type": "sleep",
      "params": {
        "label": "3초 대기",
        "seconds": "3"
      }
    },
    {
      "type": "youtube",
      "params": {
        "label": "Shorts 10초 관측 · 광고 제외",
        "action": "watch",
        "seconds": "10",
        "surface": "shorts",
        "ad_timeout": "180"
      }
    },
    {
      "type": "youtube",
      "params": {
        "label": "네트워크 10초 차단·원복",
        "action": "network_cycle",
        "seconds": "10"
      }
    },
    {
      "type": "sleep",
      "params": {
        "label": "5초 대기",
        "seconds": "5"
      }
    },
    {
      "type": "youtube",
      "params": {
        "label": "재생 확인",
        "action": "control",
        "target": "play"
      }
    },
    {
      "type": "youtube",
      "params": {
        "label": "Shorts 30초 관측 · 광고 제외",
        "action": "watch",
        "seconds": "30",
        "surface": "shorts",
        "ad_timeout": "180"
      }
    },
    {
      "type": "stop_app",
      "params": {
        "label": "YouTube 종료",
        "package_name": "com.google.android.youtube"
      }
    },
    {
      "params": {
        "label": "Trace 종료 및 결과 저장",
        "trace_type": "fsio_ufs"
      },
      "type": "trace_stop"
    }
  ],
  "loops": [],
  "requirements": {
    "packages": [
      "com.google.android.youtube"
    ],
    "traceType": "fsio_ufs"
  }
}
