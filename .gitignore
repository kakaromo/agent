# Binary (루트 바이너리만 — ui/src/routes/agent/ 가 매칭되지 않도록 / prefix)
/agent
/agent.exe
/iotest
/goparse
dist/

# Tools (ARM64 binaries, too large for git)
tools/fio
tools/iozone
tools/tiotest
tools/trace
tools/iotest
tools/fsiotrace

# APK 번들 — binary, 로컬에서만 사용 (README 만 추적)
tools/apks/*.apk

# Trace output
/tmp/agent_trace/

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store

# UI build artifacts (regenerated by build-ui.sh, embedded into Go binary)
ui/node_modules/
ui/build/*
!ui/build/.gitkeep
ui/.svelte-kit/

# 다른 AI 도구의 로컬 설정 — 이 저장소의 산출물이 아니라 각자 환경에 딸린 파일이다.
# (CLAUDE.md 는 프로젝트 규약이라 추적하지만, 이쪽은 개인 도구 설정이라 제외)
.codex/
AGENTS.md
